PROJECT_NAME="EPIC Booking"
ENVIRONMENT=local

# Postgres
# POSTGRES_USER=postgres
POSTGRES_USER=EPIC
#gearate with openssl rand -hex 32
POSTGRES_PASSWORD= ''
POSTGRES_DB=app
POSTGRES_PORT=5433

# docker compose overrides the host to `db`.
DATABASE_URL=postgresql://EPIC:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/app
TEST_DATABASE_URL=postgresql://EPIC:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/app_test

# Frontend origin(s) allowed by CORS
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
